# Copy this file to stack.env or run provision-host.sh, then enter the values as
# Portainer stack environment variables. stack.env is gitignored and contains secrets.
RELAY_IMAGE=your-docker-hub-account/relay:latest
RELAY_HOSTNAME=relay.hades.ws
RELAY_BIND_ADDRESS=0.0.0.0
RELAY_PORT=9095

POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=generate-a-long-random-value
DATABASE_URL=postgres://relay:SAME_PASSWORD_AS_ABOVE@postgres:5432/relay
BETTER_AUTH_SECRET=generate-an-independent-long-random-value
RELAY_REALTIME_SECRET=generate-an-independent-long-random-value
RELAY_INVITATION_DELIVERY_MODE=manual
RELAY_EMAIL_DELIVERY_URL=
RELAY_GITHUB_APP_ID=123456
# Escape PEM line breaks as literal \n characters on this one line.
RELAY_GITHUB_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
RELAY_GITHUB_WEBHOOK_SECRET=use-the-same-random-value-configured-on-the-github-app
RELAY_CODEX_BIN=codex
RELAY_JITSI_BASE_URL=https://meet.jit.si
RELAY_JITSI_EMBED_ENABLED=false
RELAY_BACKUP_INTERVAL_SECONDS=86400
RELAY_BACKUP_RETENTION_DAYS=14
RELAY_EVALUATION_RETENTION_INTERVAL_SECONDS=3600
