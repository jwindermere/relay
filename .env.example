POSTGRES_DB=relay
POSTGRES_USER=relay

# Each path is mounted only into the services that require that secret. Keep the
# files outside version control, mode 0600, and rotate them independently.
RELAY_POSTGRES_PASSWORD_FILE=./secrets/postgres-password
RELAY_DATABASE_URL_FILE=./secrets/database-url
RELAY_BETTER_AUTH_SECRET_FILE=./secrets/better-auth-secret
RELAY_EMAIL_DELIVERY_TOKEN_FILE=./secrets/email-delivery-token
RELAY_REALTIME_SECRET_FILE=./secrets/realtime-secret
RELAY_GITHUB_PRIVATE_KEY_FILE=./secrets/github-private-key.pem
RELAY_GITHUB_WEBHOOK_SECRET_FILE=./secrets/github-webhook-secret
RELAY_TLS_CERTIFICATE_FILE=./secrets/tls-certificate.pem
RELAY_TLS_PRIVATE_KEY_FILE=./secrets/tls-private-key.pem

RELAY_HOSTNAME=relay.example.com
RELAY_EMAIL_DELIVERY_URL=https://mail-gateway.example/relay
RELAY_GITHUB_APP_ID=123456
RELAY_CODEX_BIN=codex
# Public fallback. For production at hades.ws, self-host Jitsi on its own origin:
# RELAY_JITSI_BASE_URL=https://meet.hades.ws
# RELAY_JITSI_EMBED_ENABLED=true
# Embedding is deliberately refused for meet.jit.si and for URL subpaths.
RELAY_JITSI_BASE_URL=https://meet.jit.si
RELAY_JITSI_EMBED_ENABLED=false

# This must be a mounted off-host filesystem, not the Relay host's local disk.
RELAY_BACKUP_DIRECTORY=/mnt/off-host/relay-postgres
RELAY_BACKUP_INTERVAL_SECONDS=86400
RELAY_BACKUP_RETENTION_DAYS=14
