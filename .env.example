POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://relay:change-me@postgres:5432/relay
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
RELAY_EMAIL_DELIVERY_URL=https://mail-gateway.example/relay
RELAY_EMAIL_DELIVERY_TOKEN=replace-with-mail-gateway-token
# Optional path to a locally installed Codex executable.
RELAY_CODEX_BIN=codex
# Dedicated GitHub App: Metadata read, Contents write, Pull requests write.
RELAY_GITHUB_APP_ID=123456
# PEM content may use literal newlines or escaped \n sequences.
RELAY_GITHUB_PRIVATE_KEY=replace-with-the-github-app-private-key
HOST=0.0.0.0
PORT=3000
