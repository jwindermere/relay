{
  "name": "relay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:runtime",
    "build:web": "vite build",
    "build:runtime": "esbuild src/worker/main.ts src/bin/migrate.ts src/bin/web.ts src/bin/bootstrap-owner.ts --bundle --platform=node --format=esm --packages=external --outdir=build-runtime",
    "dev:web": "vite dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "db:migrate": "tsx src/bin/migrate.ts",
    "bootstrap:owner": "tsx src/bin/bootstrap-owner.ts",
    "start:migrate": "node build-runtime/bin/migrate.js",
    "start:bootstrap-owner": "node build-runtime/bin/bootstrap-owner.js",
    "start:web": "node build-runtime/bin/web.js",
    "start:worker": "node build-runtime/worker/main.js",
    "prototype:agent-run": "node prototype/agent-run.mjs",
    "prototype:realtime-agent-run": "node prototype/realtime-agent-run.mjs",
    "prototype:shared-channel-ux": "npm --prefix prototype/shared-channel-ux run dev --",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.runtime.json && node --check prototype/agent-run.mjs && node --check prototype/realtime-agent-run-model.mjs && node --check prototype/realtime-agent-run.mjs",
    "test": "npm run test:prototype && npm run test:integration",
    "test:prototype": "node --test prototype/*.test.mjs",
    "test:integration": "node --import tsx --test --test-isolation=none test/*.integration.test.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "better-auth": "1.7.1",
    "daisyui": "5.7.19",
    "pg": "8.16.3",
    "svelte": "5.56.9",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.7.2",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "svelte-check": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
