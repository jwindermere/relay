{
  "name": "relay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:runtime",
    "build:web": "vite build",
    "build:runtime": "esbuild src/worker/main.ts src/bin/migrate.ts src/bin/web.ts src/bin/bootstrap-owner.ts src/bin/smoke-codex-worker.ts src/bin/verify-pilot-journey.ts --bundle --platform=node --format=esm --packages=external --outdir=build-runtime",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "dev:worker": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch src/worker/main.ts",
    "db:up": "node --env-file-if-exists=.env scripts/dev-postgres.mjs up",
    "db:down": "node --env-file-if-exists=.env scripts/dev-postgres.mjs down",
    "db:migrate": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/bin/migrate.ts",
    "bootstrap:owner": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/bin/bootstrap-owner.ts",
    "start:migrate": "node build-runtime/bin/migrate.js",
    "start:bootstrap-owner": "node build-runtime/bin/bootstrap-owner.js",
    "start:web": "node build-runtime/bin/web.js",
    "start:worker": "node build-runtime/worker/main.js",
    "start:verify-pilot": "node build-runtime/bin/verify-pilot-journey.js",
    "smoke:codex-worker": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/bin/smoke-codex-worker.ts",
    "verify:pilot": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/bin/verify-pilot-journey.ts",
    "prototype:agent-run": "node prototype/agent-run.mjs",
    "prototype:realtime-agent-run": "node prototype/realtime-agent-run.mjs",
    "prototype:shared-channel-ux": "npm --prefix prototype/shared-channel-ux run dev --",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.runtime.json && node --check prototype/agent-run.mjs && node --check prototype/realtime-agent-run-model.mjs && node --check prototype/realtime-agent-run.mjs",
    "test": "npm run test:unit && npm run test:prototype && npm run test:integration",
    "test:unit": "node --import tsx --test test/reconciliation.test.ts test/markdown.test.ts test/pilot-journey.test.ts test/approval-policy.test.ts test/accountable-collaboration.test.ts test/agent-templates.test.ts test/codex-environment.test.ts test/runtime-config.test.ts test/realtime-ticket.test.ts test/deployment.test.ts test/github-api.test.ts test/github-protection.test.ts test/github-broker.test.ts test/github-broker-remote.test.ts test/github-webhook.test.ts",
    "test:evaluation-fixtures": "node --import tsx --test --test-name-pattern='collaboration fixtures' test/accountable-collaboration.test.ts",
    "test:github-contract": "node --import tsx --test test/github-broker.contract.ts",
    "test:github-contract:required": "RELAY_GITHUB_CONTRACT_REQUIRED=true npm run test:github-contract",
    "test:prototype": "node --test prototype/*.test.mjs",
    "test:integration": "node --import tsx --test --test-isolation=none test/*.integration.test.ts",
    "test:operations": "node --import tsx --test --test-isolation=none test/operations.integration.test.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "better-auth": "1.7.1",
    "daisyui": "5.7.19",
    "marked": "^18.0.11",
    "pg": "8.16.3",
    "sanitize-html": "^2.17.7",
    "svelte": "5.56.9",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.7.2",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "svelte-check": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
